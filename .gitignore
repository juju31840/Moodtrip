# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# env — tout fichier .env, l'exemple excepte.
# Les trois motifs precedents (.env, .env.local, .env*.local) laissaient passer
# .env.production et .env.development : un fichier au nom plausible, portant les
# vrais secrets de production, serait parti dans un commit sans un mot.
.env*
!.env.local.example

# misc
.DS_Store
*.pem
npm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# workspace VS Code (chemins locaux, machine-spécifique)
*.code-workspace

# artefacts de vérification (générés, non versionnés)
/rapport.md
/.playwright-mcp/
design-canvas/

# réglages locaux : contient des jetons d'accès, jamais versionné
.claude/settings.local.json

# secrets rassemblés pour l'import Vercel — jamais versionné
vercel-env.txt
.env.vercel.local

# Captures des vérifications à l'écran
.playwright-mcp/
*-390.png
