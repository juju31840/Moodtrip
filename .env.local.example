# Clé serveur Anthropic — jamais exposée au client, jamais préfixée NEXT_PUBLIC_
ANTHROPIC_API_KEY=

# Token Mapbox — exposé au client, à restreindre par domaine dans le compte Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=

# Développement uniquement : renvoie un itinéraire factice au lieu d'appeler l'API Anthropic.
# Permet d'itérer sur la carte et la bottom sheet sans consommer de crédit. Laisser vide en prod.
VIBETRIP_MOCK=

# Générations autorisées par heure et par IP (défaut 5). À monter pour tester depuis un
# téléphone : toutes les requêtes du réseau local comptent dans le même quota.
VIBETRIP_RATE_LIMIT=

# Socle de lieux (Supabase). La clé publiable suffit : la table `places` est en lecture publique
# par RLS, et son contenu vient de Foursquare OS Places, sous licence Apache 2.0.
# Sans ces deux variables, la génération fonctionne mais sans ancrage sur des lieux réels —
# elle retombe sur l'ancien comportement (le modèle propose, on vérifie après coup).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Tâche planifiée de vérification des lieux (/api/cron/verify-places) ---
# Secret partagé avec Vercel Cron. SANS LUI LA ROUTE EST FERMÉE (503) : elle appelle
# une API facturée et écrit en base avec un jeton d'administration, elle ne doit
# jamais être joignable sans authentification.
CRON_SECRET=
# Clé Google Places, facturée à l'appel.
GOOGLE_PLACES_API_KEY=
# Référence du projet et jeton d'administration Supabase, pour l'écriture en base
# depuis la tâche planifiée. Jamais préfixés NEXT_PUBLIC_.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
